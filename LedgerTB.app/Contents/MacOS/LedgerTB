#!/bin/bash
# LedgerTB.app launcher: runs the desktop launcher from the repo root using a
# Python that has LedgerTB's dependencies installed. Output is logged so a
# double-click failure can be diagnosed.

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Repo root is three levels up: Contents/MacOS -> Contents -> LedgerTB.app -> repo
ROOT="$(cd "$HERE/../../.." && pwd)"
cd "$ROOT" || exit 1

# Pick a Python with the deps (override with LEDGERTB_PYTHON if your env
# differs): LEDGERTB_PYTHON (or legacy PROBOOKS_PYTHON), a repo-local venv,
# then python3 on PATH.
PY="${LEDGERTB_PYTHON:-${PROBOOKS_PYTHON:-$ROOT/.macos-venv/bin/python}}"
if [ ! -x "$PY" ]; then
    PY="$(command -v python3 || command -v python)"
fi

LOG="$HOME/Library/Logs/LedgerTB.log"

# Apple Silicon: LaunchServices starts this bundle under Rosetta (the bundle
# executable is a script, so there is no Mach-O slice for it to pick from), and
# a repo venv's wheels are arm64-only -- numpy's C extension then refuses to
# load and every page dies on `import pandas`. Force the native slice; on Intel
# the check fails and nothing changes.
ARCH=""
if [ "$(sysctl -n hw.optional.arm64 2>/dev/null)" = "1" ]; then
    ARCH="arch -arm64"
fi
exec $ARCH "$PY" desktop.py >>"$LOG" 2>&1
