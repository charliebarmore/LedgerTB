#!/bin/bash
# LedgerTB.app launcher: runs the desktop launcher from the repo root using a
# Python that has LedgerTB's dependencies installed. Output is logged so a
# double-click failure can be diagnosed.

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Repo root is three levels up: Contents/MacOS -> Contents -> LedgerTB.app -> repo
ROOT="$(cd "$HERE/../../.." && pwd)"
cd "$ROOT" || exit 1

# Pick a Python with the deps (override with LEDGERTB_PYTHON if your env
# differs): LEDGERTB_PYTHON (or legacy PROBOOKS_PYTHON), a repo-local venv,
# then python3 on PATH.
PY="${LEDGERTB_PYTHON:-${PROBOOKS_PYTHON:-$ROOT/.macos-venv/bin/python}}"
if [ ! -x "$PY" ]; then
    PY="$(command -v python3 || command -v python)"
fi

LOG="$HOME/Library/Logs/LedgerTB.log"
exec "$PY" desktop.py >>"$LOG" 2>&1
